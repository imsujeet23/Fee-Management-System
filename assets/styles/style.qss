/* ---------- Main Window ---------- */

QMainWindow {
    background-color: #F5F7FA;
}

/* ---------- Widgets ---------- */

QWidget {
    background-color: #F5F7FA;
    color: #2C3E50;
    font-family: "Segoe UI";
    font-size: 11pt;
}

/* ---------- Labels ---------- */

QLabel {
    color: #2C3E50;
}

/* ---------- Title ---------- */

QLabel#titleLabel {
    font-size: 24pt;
    font-weight: bold;
    color: #1565C0;
}

/* ---------- Line Edit ---------- */

QLineEdit {
    background-color: white;
    color: black;
    border: 2px solid #D6D6D6;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #1976D2;
    selection-color: white;
}

QLineEdit:focus {
    border: 2px solid #1976D2;
}

/* ---------- Buttons ---------- */

QPushButton {
    background-color: #1976D2;
    color: white;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1565C0;
}

QPushButton:pressed {
    background-color: #0D47A1;
}

/* ---------- Tables ---------- */

QTableWidget {
    background: white;
    border: none;
    gridline-color: #E0E0E0;
}

/* ---------- Group Box ---------- */

QGroupBox {
    border: 1px solid #CCCCCC;
    border-radius: 8px;
    margin-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    left: 10px;
    padding: 2px;
}
/* ---------------------------
   Statistic Cards
---------------------------- */

QFrame#statCard{
    background:white;
    border-radius:15px;
    border:1px solid #D9D9D9;
}

QFrame#statCard:hover{
    border:2px solid #1976D2;
}

QLabel#cardTitle{
    font-size:14px;
    color:#666666;
    font-weight:600;
}

QLabel#cardValue{
    font-size:28px;
    color:#1565C0;
    font-weight:bold;
}
/* ---------------- Top Bar ---------------- */

QWidget#topbar{
    background-color: white;
    border-bottom:1px solid #DADADA;
}

QLabel#topbarTitle{
    color:#1565C0;
    font-size:22px;
    font-weight:bold;
}

QLabel#userLabel{
    color:#2C3E50;
    font-weight:bold;
    font-size:13px;
}

QLabel#dateLabel{
    color:#6B7280;
    font-size:12px;
}