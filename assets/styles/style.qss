/* ---------- Main Window ---------- */

QMainWindow {
    background-color: #F5F7FA;
}

/* ---------- Widgets ---------- */

QWidget {
    background-color: #F5F7FA;
    font-family: "Segoe UI";
    font-size: 11pt;
}

/* ---------- Labels ---------- */

QLabel {
    color: #2C3E50;
}

/* ---------- Title ---------- */

QLabel#titleLabel {
    font-size: 24pt;
    font-weight: bold;
    color: #1565C0;
}

/* ---------- Line Edit ---------- */

QLineEdit {
    background: white;
    border: 2px solid #D6D6D6;
    border-radius: 8px;
    padding: 8px;
}

QLineEdit:focus {
    border: 2px solid #1976D2;
}

/* ---------- Buttons ---------- */

QPushButton {
    background-color: #1976D2;
    color: white;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1565C0;
}

QPushButton:pressed {
    background-color: #0D47A1;
}

/* ---------- Tables ---------- */

QTableWidget {
    background: white;
    border: none;
    gridline-color: #E0E0E0;
}

/* ---------- Group Box ---------- */

QGroupBox {
    border: 1px solid #CCCCCC;
    border-radius: 8px;
    margin-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    left: 10px;
    padding: 2px;
}